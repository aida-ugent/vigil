{
  "name": "vigil-extension",
  "version": "0.1.0",
  "description": "Cognitive bias detection and reformulation for web content.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run assets && node scripts/build.mjs --watch",
    "build": "npm run assets && tsc && node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "assets": "node scripts/embedding-assets.mjs",
    "assets:ort": "node scripts/embedding-assets.mjs ort",
    "assets:model": "node scripts/embedding-assets.mjs model",
    "assets:check": "node scripts/embedding-assets.mjs check",
    "test:embeddings": "npm run assets:check && node scripts/test-embeddings.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/stopword": "^2.0.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@mlc-ai/web-llm": "^0.2.86",
    "stopword": "^3.1.5",
    "zod": "^4.6.7"
  }
}
